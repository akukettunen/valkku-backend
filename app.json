{
  "name": "valkku-backend",
  "description": "Express.js + TypeScript backend for Valkku",
  "repository": "https://github.com/yourusername/valkku-backend",
  "logo": "https://nodejs.org/static/images/logo.svg",
  "keywords": ["node", "express", "typescript", "api"],
  "env": {
    "NODE_ENV": {
      "description": "Node environment",
      "value": "production"
    },
    "JWT_SECRET": {
      "description": "Secret key for JWT tokens",
      "generator": "secret"
    },
    "JWT_ISSUER": {
      "description": "JWT issuer",
      "value": "valkku-backend"
    },
    "JWT_AUDIENCE": {
      "description": "JWT audience",
      "value": "valkku-app"
    },
    "REFRESH_TOKEN_VALID_DAYS": {
      "description": "Number of days refresh tokens are valid",
      "value": "90"
    },
    "REFRESH_PEPPER": {
      "description": "Pepper for refresh tokens",
      "generator": "secret"
    },
    "INVITE_TOKEN_PEPPER": {
      "description": "Pepper for invite tokens",
      "generator": "secret"
    },
    "CORS_ORIGINS": {
      "description": "Comma-separated list of allowed CORS origins",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "addons": [
    {
      "plan": "cleardb:ignite"
    }
  ],
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
